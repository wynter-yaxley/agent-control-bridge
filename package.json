{
  "name": "agent-control-bridge",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "agent-control-bridge-mcp": "dist/mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wynter-yaxley/agent-control-bridge.git"
  },
  "files": [
    "dist",
    "skills",
    "config",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "description": "MCP server that lets Hermes (or any MCP client) drive the ChatGPT and Codex desktop apps: workspaces, conversations, prompts and replies",
  "keywords": ["mcp", "hermes", "codex", "chatgpt", "agent"],
  "scripts": {
    "prepare": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "start": "node dist/mcp.js",
    "check": "node dist/mcp.js --check",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  }
}
