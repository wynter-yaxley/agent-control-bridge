{
  "name": "agent-control-bridge",
  "version": "0.6.1",
  "private": true,
  "license": "MIT",
  "bin": {
    "agent-control-bridge": "dist/mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wynter-yaxley/agent-control-bridge.git"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "description": "MCP server for the ChatGPT desktop app: list, read, create and message ChatGPT and Codex conversations",
  "scripts": {
    "prepare": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "start": "node dist/mcp.js",
    "smoke": "node scripts/smoke.mjs",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "codex",
    "windows"
  ]
}
