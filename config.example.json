{
  "database": {
    "path": "./data/bridge.db",
    "busyTimeoutMs": 5000
  },
  "watcher": {
    "intervalMs": 60000,
    "timeoutMs": 10000
  },
  "nativeInterface": {
    "timeoutMs": 30000,
    "maxFrameBytes": 2097152,
    "maxCandidates": 16
  },
  "feishu": {
    "apiOrigin": "https://open.feishu.cn",
    "timeoutMs": 15000
  },
  "background": {
    "intervalMs": 60000,
    "timeoutMs": 120000,
    "leaseSeconds": 600,
    "workspaceRoot": "./workspaces",
    "maxConcurrent": 1,
    "notificationLeaseMs": 30000
  },
  "agents": {
    "chatgpt": {
      "enabled": false,
      "model": "gpt-6",
      "reasoningEffort": "high"
    },
    "codex": {
      "enabled": false,
      "model": null,
      "reasoningEffort": null
    },
    "hermes": {
      "enabled": false
    },
    "pi": {
      "enabled": false
    }
  },
  "desktop": {
    "enabled": false,
    "cdpUrl": "http://127.0.0.1:9222",
    "python": "python",
    "allowForegroundAutomation": false,
    "allowPhysicalInput": false,
    "uiPollMs": 100,
    "remoteAllowOrigins": "http://127.0.0.1:9222"
  },
  "logging": {
    "level": "info",
    "redactSecrets": true
  },
  "failureReporting": {
    "blockedAfterMs": 600000
  }
}
