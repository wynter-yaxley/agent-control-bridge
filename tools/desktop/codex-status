#!/usr/bin/env python3
# codex-status — 读 Codex 任务进度/成果（本地会话档案，只读，零凭据）
# 数据源：
#   - thread_history_1.sqlite：thread_turns（进度）+ thread_items（userMessage/agentMessage/fileChange）
#   - .codex-global-state.json：thread → 项目映射
# 用法：
#   codex-status                  # 列出所有线程的最近状态
#   codex-status --thread <id>    # 看某个线程的最近消息与文件改动
#   codex-status --project <名称> # 看某项目的线程
#   codex-status --limit N        # 每个线程最多显示 N 条
import sqlite3
import json
import sys
import datetime

import os
from pathlib import Path
from desktop_common import entry, ToolError, redact, read_bounded_json
import argparse
config_file=Path(os.environ.get('ACB_CONFIG',Path(__file__).resolve().parents[2]/'.bridge.config.json')); settings=read_bounded_json(config_file) or {}; configured=settings.get('agents',{}).get('codex',{}).get('statePath'); state_file=(config_file.resolve().parent/ configured).resolve() if configured else Path.home()/'.codex'/'.codex-global-state.json'; CODEX_DIR=Path(os.environ.get('ACB_CODEX_HOME',state_file.parent))
DB_PATH = str(CODEX_DIR/'thread_history_1.sqlite')
STATE_PATH = str(CODEX_DIR/'.codex-global-state.json')


def tz8(ts: float | int | None) -> str:
    if not ts:
        return "?"
    return datetime.datetime.fromtimestamp(ts, datetime.timezone(datetime.timedelta(hours=8))).strftime("%m-%d %H:%M:%S")


def load_projects() -> tuple[dict, dict]:
    """返回 (thread->projectName, projectId->projectName)"""
    try:
        with open(STATE_PATH, "r", encoding="utf-8") as f:
            state = json.load(f)
    except Exception:
        return {}, {}
    proj = {p["id"]: p["name"] for p in state.get("local-projects", {}).values()}
    assign = state.get("thread-project-assignments", {})
    thread2proj = {tid: proj.get(a.get("projectId", ""), "?") for tid, a in assign.items()}
    return thread2proj, proj


def fmt_item(item_type: str, item_json: str) -> str:
    try:
        j = json.loads(item_json)
    except Exception:
        return ""
    if item_type == "userMessage":
        parts = [c.get("text", "") for c in j.get("content", []) if isinstance(c, dict)]
        text = " ".join(parts).strip()
        return f"[用户] {text[:120]}"
    if item_type == "agentMessage":
        return f"[助手] {j.get('text', '')[:120]}"
    if item_type == "fileChange":
        paths = [c.get("path", "").split("\\")[-1] for c in j.get("changes", []) if isinstance(c, dict)]
        return f"[改动文件] {', '.join(paths[:8])}"
    if item_type == "commandExecution":
        return "[执行命令]"
    if item_type == "reasoning":
        return "[推理]"
    return f"[{item_type}]"


def main():
    parser=argparse.ArgumentParser(description='Bounded, read-only Codex metadata; not live execution proof')
    parser.add_argument('--thread'); parser.add_argument('--project'); parser.add_argument('--limit',type=int,default=6)
    args=parser.parse_args();filter_thread=args.thread;filter_project=args.project;limit=args.limit
    if limit < 1 or limit > 100: raise ToolError('INPUT','limit must be 1..100',2)
    thread2proj, proj = load_projects()

    try:
        # 只读 URI 直接打开（不复制副本，避免临时文件与锁冲突）
        conn = sqlite3.connect(Path(DB_PATH).resolve().as_uri()+'?mode=ro', uri=True, timeout=5)
    except Exception as e:
        print("Codex metadata database unavailable",file=sys.stderr)
        sys.exit(2)

    # 每个 thread 的最近 turn 状态
    last_turn = {}
    for tid, turn_id, status, started, completed, dur in conn.execute(
        "SELECT thread_id, turn_id, status, started_at, completed_at, duration_ms FROM (SELECT *, ROW_NUMBER() OVER(PARTITION BY thread_id ORDER BY started_at DESC) n FROM thread_turns) WHERE n=1 ORDER BY started_at DESC LIMIT 200"
    ):
        key = (tid,)
        cur = (turn_id, status, started, completed, dur)
        if tid not in last_turn or (started or 0) > (last_turn[tid][2] or 0):
            last_turn[tid] = cur

    # 最近的消息（按 thread 分组）
    recent_items = {}
    for tid, item_id, item_type, item_json, created in conn.execute(
        "SELECT thread_id, item_id, item_type, item_json, created_at_ms FROM (SELECT *,ROW_NUMBER() OVER(PARTITION BY thread_id ORDER BY created_at_ms DESC) n FROM thread_items) WHERE n<=? ORDER BY created_at_ms DESC LIMIT 20000", (limit,)
    ):
        if tid not in recent_items:
            recent_items[tid] = []
        if len(recent_items[tid]) < limit:
            recent_items[tid].append((item_type, item_json, created))

    conn.close()

    # 过滤
    threads = list(last_turn.keys())
    if filter_thread:
        threads = [t for t in threads if filter_thread in t]
    if filter_project:
        threads = [t for t in threads if thread2proj.get(t, "?") == filter_project]

    if not threads:
        print("(无匹配的线程)")
        sys.exit(0)

    for tid in sorted(threads, key=lambda t: -(last_turn[t][2] or 0)):
        turn_id, status, started, completed, dur = last_turn[tid]
        pname = thread2proj.get(tid, "?")
        dur_min = f"{dur / 60000:.1f}min" if dur else "?"
        print(redact(f"── {pname} | thread {tid[:8]} | 最近turn [{status}] {tz8(started)} ~ {tz8(completed)} ({dur_min})"))
        for item_type, item_json, created in reversed(recent_items.get(tid, [])):
            line = fmt_item(item_type, item_json)
            if line:
                print(redact(f"    {tz8(created / 1000)} {line}"))


if __name__ == "__main__":
    sys.exit(entry(main))
